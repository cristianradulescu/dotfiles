{
  "Get request block": {
    "prefix": "get",
    "body": [
      "GET ${1:url} HTTP/1.1"
    ],
    "description": "GET Request"
  },
  "Delete request block": {
    "prefix": "delete",
    "body": [
      "DELETE ${1:url} HTTP/1.1"
    ],
    "description": "DELETE Request"
  },
  "Post request block": {
    "prefix": "post",
    "body": [
      "POST ${1:url} HTTP/1.1",
      "${2:header name}: ${3:header value}",
      "",
      "${4:content}"
    ],
    "description": "POST Request"
  },
  "Put request block": {
    "prefix": "put",
    "body": [
      "PUT ${1:url} HTTP/1.1",
      "${2:header name}: ${3:header value}",
      "",
      "${4:content}"
    ],
    "description": "PUT Request"
  },
  "multipart/form-data request block": {
    "prefix": "mfr",
    "body": [
      "POST ${1:url} HTTP/1.1",
      "Content-Type: multipart/form-data; boundary=WebAppBoundary",
      "",
      "--WebAppBoundary",
      "Content-Disposition: form-data; name=\"${2:field-name}\"",
      "",
      "${3:field-value}",
      "--WebAppBoundary",
      "Content-Disposition: form-data; name=\"${4:field-name}\"; filename=\"${5:file-name.txt}\"",
      "",
      "< ${6:./relative/path/to/local_file.txt}",
      "--WebAppBoundary--"
    ],
    "description": "multipart/form-data request with text and file data "
  },
  "Pre-request block": {
    "prefix": "prer",
    "body": [
      "@lang javascript",
      "< {%",
      "  ${0:content}",
      "%}"
    ],
    "description": "Pre-request script"
  },
  "Post-request block": {
    "prefix": "postr",
    "body": [
      "< {%",
      "  ${0:content}",
      "%}"
    ],
    "description": "Post-request script"
  }
}
